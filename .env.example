# ResearchFlow AI configuration. Copy to .env (shared defaults) and put secrets in
# .env.local (git-ignored). .env.local overrides .env; real environment variables
# override both.

# --- Gemini (LLM) -------------------------------------------------------------------
# Without any key the app starts in limited mode (UI, health, document management work;
# questions return a configuration error).
# Keys form a rotating pool (up to GOOGLE_API_KEY_10). The pool sticks to the active key
# and moves to the next one when a key is rate limited/exhausted or rejected.
# NOTE: free-tier quotas are per Google Cloud *project*: keys from the same project
# share one quota, so only keys from different projects add capacity.
GOOGLE_API_KEY_1=
GOOGLE_API_KEY_2=
# GOOGLE_API_KEYS=key-a,key-b          # alternative comma-separated form
CHAT_MODEL=gemini-3.5-flash
# Tried with every key once the primary model's quota is exhausted (quotas are per model).
CHAT_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60
KEY_COOLDOWN_SECONDS=60                # bench time after a 429 without retryDelay
KEY_DAILY_QUOTA_COOLDOWN_SECONDS=3600  # bench time after a daily-quota 429
LLM_MAX_WAIT_SECONDS=65                # wait for a key to recover before failing
LLM_MAX_TRANSIENT_FAILOVERS=3          # keys tried on 5xx/timeouts per call
LLM_INVALID_OUTPUT_RETRIES=1           # re-ask on unparseable structured output

# --- Embeddings ---------------------------------------------------------------------
# huggingface = sentence-transformers (default). hashing = lexical, offline,
# development/tests only (e.g. Intel macOS where PyTorch is unavailable).
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# --- Storage --------------------------------------------------------------------------
DATA_DIR=./data
# DATABASE_URL=sqlite:///./data/researchflow.db
# CHECKPOINT_DB_PATH=./data/checkpoints.db
# UPLOAD_DIR=./data/uploads
# VECTOR_STORE_DIR=./data/vector_store

# --- Ingestion & retrieval ------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=20
MAX_FILES_PER_UPLOAD=10
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5
MAX_EVIDENCE_CHUNKS=8
RETRIEVAL_MIN_SCORE=0.1

# --- Workflow -------------------------------------------------------------------------
MAX_RETRIES=2
MAX_QUESTION_CHARS=2000
MAX_HISTORY_TURNS=6

# --- API / UI -------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:8501
API_BASE_URL=http://localhost:8000
API_TIMEOUT_SECONDS=180
LOG_LEVEL=INFO

# --- LangSmith tracing (disabled unless both are set) ---------------------------------
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=researchflow-ai
